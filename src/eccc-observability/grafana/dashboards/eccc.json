{
  "uid": "eccc-overview",
  "title": "ECCC Weather Alerts",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "tags": ["eccc"],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Kafka throughput (eccc-events, msgs/min)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "round(increase(eccc_kafka_messages_produced_total{topic=\"eccc-events\"}[1m]))",
          "legendFormat": "produced"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "AMQP connection drops",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "round(sum(increase(eccc_amqp_drops_total[$__range])))",
          "instant": true,
          "range": false,
          "legendFormat": "drops"
        }
      ]
    }
  ]
}
